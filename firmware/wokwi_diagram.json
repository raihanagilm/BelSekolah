    [ "relay:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "relay:IN", "esp:4", "orange", [ "v0" ] ],
    [ "esp:2", "led:A", "blue", [ "v0" ] ],
    [ "led:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ]
