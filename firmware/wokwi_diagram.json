    { "type": "wokwi-ds1307", "id": "rtc", "top": -140, "left": -80, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay", "top": -140, "left": 160, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 140, "left": 160, "attrs": { "color": "blue", "label": "Status Bel / Relay" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 180, "left": 160, "attrs": { "value": "220" } }
